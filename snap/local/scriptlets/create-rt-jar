#!/usr/bin/env python3
"""Pre-extract Java runtime rt.jar from jimage modules for Krakatau decompiler."""

import os
import sys
import zipfile

def main():
    if len(sys.argv) < 3:
        print(f"Usage: {sys.argv[0]} <extracted_modules_dir> <output_rt_jar>", file=sys.stderr)
        sys.exit(1)

    src_dir = sys.argv[1]
    dest_jar = sys.argv[2]

    with zipfile.ZipFile(dest_jar, "w", compression=zipfile.ZIP_DEFLATED) as zf:
        for module_name in sorted(os.listdir(src_dir)):
            mod_path = os.path.join(src_dir, module_name)
            if not os.path.isdir(mod_path):
                continue
            for root, dirs, files in os.walk(mod_path):
                dirs.sort()
                for file in sorted(files):
                    if file == "module-info.class":
                        continue
                    full_path = os.path.join(root, file)
                    rel_path = os.path.relpath(full_path, mod_path)
                    try:
                        zf.write(full_path, rel_path)
                    except Exception:
                        pass

if __name__ == "__main__":
    main()
