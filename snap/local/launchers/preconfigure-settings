#!/usr/bin/env python3
"""Preconfigure Bytecode Viewer settings.bcv for the snap environment."""

import os
import sys

def main():
    if len(sys.argv) < 7:
        print(f"Usage: {sys.argv[0]} <settings_path> <python2_path> <python3_path> <rt_path> <javac_path> <java_path>", file=sys.stderr)
        sys.exit(1)

    settings_path = sys.argv[1]
    python2_path = sys.argv[2]
    python3_path = sys.argv[3]
    rt_path = sys.argv[4]
    javac_path = sys.argv[5]
    java_path = sys.argv[6]

    if os.path.exists(settings_path):
        with open(settings_path, "r", encoding="utf-8", errors="replace") as f:
            lines = [line.rstrip("\r\n") for line in f]
    else:
        # Default settings.bcv template for Bytecode Viewer 2.13.2 (exactly 144 lines: index 0 to 143)
        lines = [
            # 0: header
            "BCV: 2.13.2",
            # 1 - 10
            "true", "false", "true", "true", "true", "true", "true", "false", "true", "true",
            # 11 - 20
            "true", "true", "true", "true", "true", "true", "true", "false", "true", "false",
            # 21 - 30
            "false", "false", "true", "true", "true", "true", "true", "false", "false", "true",
            # 31 - 40
            "false", "true", "false", "false", "true", "true", "false", "false", "false", "false",
            # 41 - 50
            "false", "false", "false", "false", "false", "false", "false", "false", "false", "false",
            # 51 - 60
            "false", "false", "false", "false", "false", "false", "false", "false", "false", "false",
            # 61 - 70
            "false", "false", "false", "false", "false", "false", "false", "false", "false", "false",
            # 71 - 80
            "false", "false", "false", "false", "false", "false", "false", "false", "deprecated", "true",
            # 81 - 90: [81]: viewPane1 (4), [82]: viewPane2 (7), [83]: viewPane3 (0), [84]: refreshOnChange (true), [85]: isMaximized (false), [86]: dep, [87]: dep, [88]: lastOpenDirectory (.), [89]: python2 (""), [90]: rt ("")
            "4", "7", "0", "true", "false", "deprecated", "deprecated", ".", "", "",
            # 91 - 100: [91..100]: deprecated
            "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "deprecated",
            # 101 - 110: [101..105]: deprecated, [106]: decodeAPKResources (true), [107]: library (""), [108]: pingback (false), [109..110]: deprecated
            "deprecated", "deprecated", "deprecated", "deprecated", "deprecated", "true", "", "false", "deprecated", "deprecated",
            # 111 - 120: [111]: deprecated, [112]: fontSize (12), [113]: deleteForeignLibraries (true), [114]: apkConversion (0), [115]: python3 (""), [116]: javac (""), [117]: java (""), [118]: compileOnSave (false), [119]: autoCompileOnRefresh (false), [120]: warnForEditing (false)
            "deprecated", "12", "true", "0", "", "", "", "false", "false", "false",
            # 121 - 130: [121]: showFileInTabTitle (false), [122]: forcePureAsciiAsText (false), [123]: synchronizedViewing (true), [124]: showClassMethods (false), [125]: ren (false), [126]: deprecated, [127]: lafTheme (DARK), [128]: rstaTheme (DARK), [129]: simplifyNameInTabTitle (false), [130]: language (ENGLISH)
            "false", "false", "true", "false", "false", "deprecated", "DARK", "DARK", "false", "ENGLISH",
            # 131 - 140: [131]: viewPane1 editable (false), [132]: viewPane2 editable (false), [133]: viewPane3 editable (false), [134]: javaTools (""), [135..136]: deprecated, [137]: lastSaveDirectory (.), [138]: lastPluginDirectory (.), [139]: python2Extra (false), [140]: python3Extra (false)
            "false", "false", "false", "", "deprecated", "deprecated", ".", ".", "false", "false",
            # 141 - 143: [141]: minSdkVersion (1), [142]: printLineNumbers (false), [143]: disableReloadConfirmation (false)
            "1", "false", "false"
        ]

    # Ensure array is at least 144 lines to match SettingsSerializer schema
    while len(lines) < 144:
        lines.append("")

    # Line index 89: Configuration.python2
    if (not lines[89] or not os.path.exists(lines[89])) and os.path.exists(python2_path):
        lines[89] = python2_path

    # Line index 90: Configuration.rt
    if (not lines[90] or not os.path.exists(lines[90])) and os.path.exists(rt_path):
        lines[90] = rt_path

    # Line index 115: Configuration.python3
    if (not lines[115] or not os.path.exists(lines[115])) and os.path.exists(python3_path):
        lines[115] = python3_path

    # Line index 116: Configuration.javac
    if (not lines[116] or not os.path.exists(lines[116])) and os.path.exists(javac_path):
        lines[116] = javac_path

    # Line index 117: Configuration.java
    if (not lines[117] or not os.path.exists(lines[117])) and os.path.exists(java_path):
        lines[117] = java_path

    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    with open(settings_path, "w", encoding="utf-8") as f:
        for line in lines:
            f.write(line + "\n")

if __name__ == "__main__":
    main()
