#!/usr/bin/env bash
# This is the maintainence launcher for the snap, make necessary runtime
# environment changes to make the snap work here.  You may also insert
# security confinement/deprecation/obsoletion notice of the snap here.

set \
    -o errexit \
    -o errtrace \
    -o nounset \
    -o pipefail

#export IMPORTANT_ENVIRONMENT_VARIABLE=value

# Assume only one file
if test -f "${SNAP}/jar/Bytecode-Viewer-${SNAP_VERSION}.jar"; then
    jar_file="${SNAP}/jar/Bytecode-Viewer-${SNAP_VERSION}.jar"
elif compgen -G "${SNAP}/jar/Bytecode-Viewer-*.jar" > /dev/null; then
    jar_file="$(
        find "${SNAP}/jar" -maxdepth 1 -name "Bytecode-Viewer-*.jar" -print \
            | head --lines=1
    )"
else
    jar_file="$(
        find "${SNAP}" -maxdepth 1 -name "Bytecode-Viewer-*.jar" -print \
            | head --lines=1
    )"
fi

# This addresses the following error:
# 'import site' failed
# debug: OperationError:
# debug:  operror-type: SyntaxError
# debug:  operror-value: ('invalid syntax', ('/snap/bytecode-viewer/x8/gnome-platform/usr/lib/python3.12/codecs.py', 96, 10, '        *, _is_text_encoding=None):\n', 0))
unset PYTHONPATH

# Avoid hardcoding installation revision
snap_path_without_revision="${SNAP%/*}"
snap_stable_path="${snap_path_without_revision}/current"

# Preconfigure Python 2/3, JRT RT library, and javac paths in settings.bcv
# when missing or stale to prevent manual prompts and ClassLoaderError.
settings_file="${SNAP_USER_DATA}/.Bytecode-Viewer/settings.bcv"
python2_bin="${snap_stable_path}/bin/python"
python3_bin="${snap_stable_path}/bin/python3"
rt_jar="${snap_stable_path}/usr/lib/jvm/default-java/lib/rt.jar"
javac_bin="${snap_stable_path}/usr/lib/jvm/default-java/bin/javac"
java_bin="${snap_stable_path}/usr/lib/jvm/default-java/bin/java"

"${SNAP}/bin/preconfigure-settings" \
    "${settings_file}" \
    "${python2_bin}" \
    "${python3_bin}" \
    "${rt_jar}" \
    "${javac_bin}" \
    "${java_bin}"

# Finally run the next part of the command chain
exec \
    java \
        -Djava.security.manager=allow \
        -jar \
        "${jar_file}" \
        "${@}"
